# Publish only the curated research artifact. Everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/LICENSE
!/NOTICE
!/CITATION.cff
!/release-manifest.json
!/LICENSES/
/LICENSES/*
!/LICENSES/Apache-2.0.txt
!/LICENSES/CC-BY-4.0.txt
!/docs/
/docs/*
!/docs/theorem.md
!/docs/proof-guide.md
!/docs/effective-reduction.md
!/docs/formalization.md
!/docs/provenance.md
!/paper/
/paper/*
!/paper/README.md
!/paper/formalization-notes.md
!/paper/submission-notes.md
!/paper/manuscript.pdf
!/paper/tex/
/paper/tex/*
!/paper/tex/main.tex
!/paper/tex/metadata.tex
!/paper/tex/references.bib
!/paper/tex/sections/
/paper/tex/sections/*
!/paper/tex/sections/*.tex
!/lean/
/lean/*
!/lean/README.md
!/lean/.gitignore
!/lean/lean-toolchain
!/lean/lakefile.toml
!/lean/lake-manifest.json
!/lean/Q4.lean
!/lean/Q4/
/lean/Q4/**
!/lean/Q4/**/
!/lean/Q4/**/*.lean
!/lean/audit_sources.py
!/lean/verify.py
!/lean/source-manifest.json
!/lean/verification-summary.json
!/computations/
/computations/*
!/computations/README.md
!/computations/appendix_completion.py
!/computations/core_combinatorics.py
!/computations/program_geometry.py
!/computations/parameter_checks.py
!/computations/run_checks.py
!/computations/expected-results.json
!/audit/
/audit/*
!/audit/README.md
!/audit/verification-history.json
!/audit/lean-verification.log.gz
!/audit/new-manuscript-review.md
!/tools/
/tools/*
!/tools/repository.py
!/tools/build_paper.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/verify.yml

# Generated output is never part of the public source artifact.
**/.DS_Store
**/__pycache__/
**/*.pyc
**/.lake/
**/*.olean
**/*.ilean
**/*.aux
**/*.bbl
**/*.blg
**/*.log
**/*.out
**/*.toc
**/*.synctex.gz

# Local submission identity and its generated files must never be published.
/.local/
/private/
